# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints
.pytest_cache/

# Snakemake
.snakemake/

# Conda
env/
venv/
.conda/

# REHAB project-specific: large/generated data, never tracked in git
data/*
!data/PRJEB34634
data/PRJEB34634/*
!data/PRJEB34634/metadata
results/
status/
tmp/
containers/*.sif
logs/

# samtools sort scratch files (written to CWD -- i.e. work_dir/repo root --
# when a rule doesn't pass samtools sort -T explicitly)
samtools.*.tmp.*.bam
*.tmp.[0-9]*.bam

# emapper.py's own diamond scratch dir, written to CWD (repo root, since
# Snakemake's workdir is set there) when a rule doesn't pass --temp_dir;
# self-cleaning on success but can linger at repo root if a job is killed
emappertmp_*/

# Misc
localDB*
**localDB**
*_orig*
*.done
*.Rhistory
.RData
.claude/
