# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints
.pytest_cache/

# Snakemake
.snakemake/

# Conda
env/
venv/
.conda/

# pixi (binning/MAG module only -- see pixi.toml): pixi.toml and pixi.lock
# ARE tracked for reproducibility; the binary + global package cache
# (tools/pixi_home/) and the resolved per-environment installs (.pixi/,
# created at the repo root by pixi itself, ~27GB) are not -- rebuild both
# with `pixi install --all` after sourcing scripts/pixi_env.sh.
tools/
.pixi/

# REHAB project-specific: large/generated data, never tracked in git
data/*
!data/PRJEB34634
data/PRJEB34634/*
!data/PRJEB34634/metadata
results/
status/
tmp/
containers/*.sif
logs/

# samtools sort scratch files (written to CWD -- i.e. work_dir/repo root --
# when a rule doesn't pass samtools sort -T explicitly)
samtools.*.tmp.*.bam
*.tmp.[0-9]*.bam

# emapper.py's own diamond scratch dir, written to CWD (repo root, since
# Snakemake's workdir is set there) when a rule doesn't pass --temp_dir;
# self-cleaning on success but can linger at repo root if a job is killed
emappertmp_*/

# Misc
localDB*
**localDB**
*_orig*
*.done
*.Rhistory
.RData
.claude/
